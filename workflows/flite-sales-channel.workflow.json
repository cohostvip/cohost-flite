{
  "manifestVersion": "2",
  "id": "wf_flite-sales-channel",
  "key": "flite-sales-channel",
  "name": "Flite sales channel",
  "description": "Publishes, updates and stops Cohost channel events on Flite, and imports Flite orders into Cohost as deferred-payment orders. Connections are bound at install.",
  "trigger": { "type": "manual" },
  "variables": [
    { "key": "channelId", "type": "string", "required": true },
    { "key": "companyId", "type": "string", "required": true },
    { "key": "env", "type": "string", "required": true },
    { "key": "org", "type": "string", "required": true },
    { "key": "currency", "type": "string", "default": "USD" }
  ],
  "connections": {
    "cohost": { "app": "vip.cohost.w6w", "connection": null },
    "flite": { "app": "vip.cohost.flite", "connection": null }
  },
  "nodes": [
    {
      "id": "channel_changed",
      "uses": { "app": "vip.cohost.w6w", "action": "channel-event-changed", "trigger": true, "connectionRef": "cohost" },
      "with": { "channelId": { "$": "vars.channelId" }, "actions": ["listed", "changed", "unlisted"] }
    },
    {
      "id": "channel_ticket_changed",
      "uses": { "app": "vip.cohost.w6w", "action": "channel-ticket-changed", "trigger": true, "connectionRef": "cohost" },
      "with": { "channelId": { "$": "vars.channelId" }, "actions": ["created", "updated", "deleted"] }
    },
    {
      "id": "race",
      "uses": { "app": "@w6w/race", "action": "race" }
    },
    {
      "id": "snapshot",
      "uses": { "app": "vip.cohost.w6w", "action": "get-channel-event-snapshot", "connectionRef": "cohost" },
      "with": {
        "channelId": { "$": "vars.channelId" },
        "eventId": { "$": "steps.race.output.meta.eventId" },
        "companyId": { "$": "steps.race.output.meta.companyId" },
        "listingId": { "$": "steps.race.output.meta.listingId" },
        "mappingLabels": {
          "provider": "flite",
          "env": { "$": "vars.env" },
          "org": { "$": "vars.org" },
          "channelId": { "$": "vars.channelId" }
        }
      }
    },
    {
      "id": "desired",
      "uses": { "app": "vip.cohost.transformers.flite", "action": "channel-event-to-flite" },
      "with": {
        "snapshot": { "$": "steps.snapshot.output" },
        "env": { "$": "vars.env" },
        "org": { "$": "vars.org" },
        "currency": { "$": "vars.currency" }
      }
    },
    {
      "id": "sync",
      "uses": { "app": "vip.cohost.flite", "action": "sync-event", "connectionRef": "flite" },
      "with": {
        "desired": { "$": "steps.desired.output.desired" },
        "expectedEnv": { "$": "vars.env" }
      }
    },
    {
      "id": "register",
      "uses": { "app": "vip.cohost.w6w", "action": "register-urn-mappings", "connectionRef": "cohost" },
      "with": { "mappings": { "$": "steps.sync.output.registrations" } },
      "retry": { "maxAttempts": 3, "backoff": "exponential", "delayMs": 1000 }
    },
    {
      "id": "report",
      "uses": { "app": "@w6w/script", "action": "run" },
      "with": {
        "code": "if (Array.isArray(input) && input.length > 0) { throw new Error('sync-event reported ' + input.length + ' error(s): ' + JSON.stringify(input)); } return { ok: true };",
        "input": { "$": "steps.sync.output.errors" }
      }
    },
    {
      "id": "order_placed",
      "uses": { "app": "vip.cohost.flite", "action": "order-placed", "trigger": true, "connectionRef": "flite" }
    },
    {
      "id": "order_transform",
      "uses": { "app": "vip.cohost.transformers.flite", "action": "transform-order" },
      "with": {
        "order": { "$": "steps.order_placed.output.order" },
        "companyId": { "$": "vars.companyId" },
        "env": { "$": "vars.env" }
      }
    },
    {
      "id": "order_mapping",
      "uses": { "app": "vip.cohost.w6w", "action": "find-mapped-resources", "connectionRef": "cohost" },
      "with": {
        "urn": { "$": "steps.order_transform.output.order.contextId" },
        "labels": {
          "provider": "flite",
          "env": { "$": "vars.env" },
          "org": { "$": "vars.org" },
          "channelId": { "$": "vars.channelId" },
          "kind": "event"
        }
      }
    },
    {
      "id": "order_guard",
      "uses": { "app": "@w6w/script", "action": "run" },
      "with": {
        "code": "if (!Array.isArray(input) || input.length === 0) { throw new Error('unmapped Flite event: no URN mapping from this channel for the order event; order not imported'); } return { ok: true };",
        "input": { "$": "steps.order_mapping.output.results" }
      }
    },
    {
      "id": "order_upsert",
      "uses": { "app": "vip.cohost.w6w", "action": "upsert-order", "connectionRef": "cohost" },
      "with": { "data": { "order": { "$": "steps.order_transform.output.order" } } },
      "retry": { "maxAttempts": 3, "backoff": "exponential", "delayMs": 1000 }
    }
  ],
  "edges": [
    { "from": "channel_changed", "to": "race" },
    { "from": "channel_ticket_changed", "to": "race" },
    { "from": "race", "to": "snapshot" },
    { "from": "snapshot", "to": "desired" },
    { "from": "desired", "to": "sync" },
    { "from": "sync", "to": "register" },
    { "from": "register", "to": "report" },
    { "from": "order_placed", "to": "order_transform" },
    { "from": "order_transform", "to": "order_mapping" },
    { "from": "order_mapping", "to": "order_guard" },
    { "from": "order_guard", "to": "order_upsert" }
  ]
}
